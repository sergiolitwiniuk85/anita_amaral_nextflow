# Usa Ubuntu 22.04 como base
FROM ubuntu:22.04

# Evita prompts interactivos en la instalación
ENV DEBIAN_FRONTEND=noninteractive

# Actualiza e instala dependencias esenciales
RUN apt-get update -y && apt-get install -y \
    curl wget git make cmake build-essential \
    python3 python3-pip python3-venv && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Crea una carpeta de trabajo
WORKDIR /app

# Descarga e instala Miniconda
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/miniconda && \
    rm /tmp/miniconda.sh

# Agrega Miniconda al PATH
ENV PATH="/opt/miniconda/bin:$PATH"

# Inicializa Conda para que funcione en shells no interactivos
RUN conda init bash

# Instala Mamba para mejorar la velocidad de instalación
RUN conda install -y conda-forge::mamba && conda clean --all -y

# Crea un entorno Conda y lo activa en cada nueva sesión
RUN mamba create -y -n busco_env -c bioconda -c conda-forge busco=5.8.2 snikt && \
    echo "source /opt/miniconda/bin/activate busco_env" >> ~/.bashrc

# Usa Bash como shell predeterminado para que se active el entorno
SHELL ["/bin/bash", "-c"]

# Abre un bash interactivo con el entorno activado
CMD ["/bin/bash", "--login"]

